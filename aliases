################################# UTILITIES ###################################
function cd {
  DIRECTORY=$1
  if [[ "$1" = "m" || "$1" = "np" || "$1" = "p" ]]; then
    if [[ "$1" = "np" ]]; then EGENV="nonprod"; fi
    if [[ "$1" = "p" ]]; then EGENV="prod"; fi
    if [[ "$1" = "m" ]]; then EGENV="mgmt"; fi
    DIRECTORY="$EGINF/$EGENV"
    case "$2" in
      "tf")
        DIRECTORY="$EGINF/$EGENV/terraform"
        ;;
      "k8s")
        DIRECTORY="$EGINF/$EGENV/k8s/us-east-1" # Default to us-east-1
        case "$3" in
          "use1")
            DIRECTORY="$EGINF/$EGENV/k8s/us-east-1"
            ;;
          "use2")
            DIRECTORY="$EGINF/$EGENV/k8s/us-east-2"
            ;;
          "euw1")
            DIRECTORY="$EGINF/$EGENV/k8s/eu-west-1"
            ;;
        esac
        ;;
    esac
  elif [[ "$1" = "tfm" ]]; then
    DIRECTORY="$EGTFM"
  fi

  pushd "$DIRECTORY" > /dev/null
}

