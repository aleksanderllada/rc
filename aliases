function nomad-login {
  if [ -z "$NOMAD_ADDR" ]; then
    if [ $# -eq 0 ]; then
      echo "Missing address to the Nomad cluster. Either export the NOMAD_ADDR environment variable or run 'nomad-login <address>'"
      return
    fi
    export NOMAD_ADDR="$1"
  fi

  echo "Authenticating to $NOMAD_ADDR"
  export NOMAD_TOKEN=$(nomad login -json | jq -r ".SecretID")
}

