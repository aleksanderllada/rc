  NS=${1:-default};
  SECRET_NAME=${2};
  SECRET_KEY=${3};

  kubectl get secrets -n monitoring ${SECRET_NAME} -o yaml | grep ${SECRET_KEY} | sed "s/[[:space:]]*${SECRET_KEY}:[[:space:]]//g" | base64 -d
}

